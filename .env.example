# ===========================================================================
# Level One — Outreach System
# ===========================================================================
# Copy to `.env.local` for local dev, or paste into Coolify's environment
# panel for deployment. Every variable below is explained in full in
# docs/OPERATIONS.md, including where to get the key and what breaks without
# it.
#
# THE ONE RULE THIS SYSTEM ENFORCES:
#   n8n sends every email that reaches a CLIENT.
#   Resend sends every email that reaches YOU, and nobody else.
# Both halves need their own credentials below.
# ===========================================================================


# ---------------------------------------------------------------------------
# 1. PocketBase — the database
# ---------------------------------------------------------------------------
# The app uses the public (unauthenticated) PocketBase client, matching the
# Proposal Engine's architecture. Every collection listed in
# docs/pocketbase-schema.json must have its List / View / Create / Update API
# rules set to public (an empty rule), or every request returns 403.
#
# When you later add a login to this app, docs/OPERATIONS.md has the exact
# rule strings to lock these collections back down.
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090


# ---------------------------------------------------------------------------
# 2. App identity
# ---------------------------------------------------------------------------
# Public address of THIS app, no trailing slash. Used to build the deep links
# inside your Resend alert emails, so a wrong value means every "open this
# lead" button in your inbox lands on a dead page.
APP_BASE_URL=https://outreach.levelone.digital

# Shared secret guarding the two INBOUND webhook routes:
#   POST /api/webhooks/inbound-reply
#   POST /api/webhooks/calendar-booked
# These URLs are public, so this is what stops anyone who finds them from
# writing junk into your pipeline. Send it as the `x-webhook-secret` header
# from n8n and from your calendar tool.
# Generate with:  openssl rand -hex 32
# Leave EMPTY to disable the check (local development only — never in prod).
WEBHOOK_SHARED_SECRET=

# Your discovery-call booking link (Cal.com, Calendly, or the Level One
# calendar app). Sent to n8n inside the positive-reply response so the email
# body can embed it.
DISCOVERY_CALL_LINK=https://cal.com/levelone/discovery

# Default Zoom/meeting link sent with a trades meeting email. Can be
# overridden per-lead from the UI before sending.
TRADES_MEETING_LINK=


# ---------------------------------------------------------------------------
# 3. Resend — INTERNAL ALERTS ONLY
# ---------------------------------------------------------------------------
# lib/resend.ts is hard-wired to INTERNAL_ALERT_EMAIL and ignores any
# recipient a caller tries to pass it. A client address can never be reached
# through Resend in this system, even by mistake.
#
# Get the key at https://resend.com/api-keys
RESEND_API_KEY=

# The verified sending identity on your Resend domain. Must be a domain you
# have verified in Resend, or sends fail with a 403.
RESEND_FROM_EMAIL=alerts@levelone.digital

# Where YOUR alerts land. This is the only address Resend will ever email.
INTERNAL_ALERT_EMAIL=dean@levelone.digital


# ---------------------------------------------------------------------------
# 4. n8n — ALL CLIENT-FACING EMAIL
# ---------------------------------------------------------------------------
# Four workflows. docs/n8n-workflows.md describes the nodes each one needs and
# the exact JSON body it will receive.
#
# If a webhook URL is left blank, the corresponding action fails loudly in the
# UI rather than silently doing nothing — the app never pretends an email was
# sent.

# Fired when you log a trades call as Positive and click "Send Meeting Email".
N8N_WEBHOOK_TRADES_MEETING=https://n8n.levelone.digital/webhook/trades-meeting

# Fired once a day with that day's batch of B2B leads — never with a whole
# import. n8n sends each first cold email, POSTs the outcome back to
# /api/webhooks/email-sent, and schedules the 2-day and 5-day follow-ups.
#
# That callback is required: a lead is only marked as emailed when n8n confirms
# it, which is what stops the next day's batch re-sending to the same person.
N8N_WEBHOOK_B2B_SEQUENCE=https://n8n.levelone.digital/webhook/b2b-sequence

# Fired when you approve and send a response to a POSITIVE reply. n8n emails
# the client and starts the 24-hour discovery-call booking timer.
N8N_WEBHOOK_DISPATCH_RESPONSE=https://n8n.levelone.digital/webhook/dispatch-response

# Fired for a NEGATIVE reply. n8n sends the polite apology with a
# time-of-day-appropriate greeting, then the app archives the run.
N8N_WEBHOOK_NEGATIVE_REPLY=https://n8n.levelone.digital/webhook/negative-reply

# Fired when a discovery call IS booked, so n8n can cancel the pending
# 24-hour nudge Wait node for that outreach run. Optional: if your workflow
# instead checks PocketBase before nudging, leave this blank.
N8N_WEBHOOK_CANCEL_NUDGE=


# ---------------------------------------------------------------------------
# 5. Google Places API — the trades grid scraper
# ---------------------------------------------------------------------------
# The scraper runs INSIDE this app. It partitions your search area into
# overlapping circular cells and runs a Nearby Search per cell, which is how
# it gets past Google's 120-result ceiling on a single search.
#
# Enable BOTH "Places API" and billing at
# https://console.cloud.google.com/apis/library/places-backend.googleapis.com
# Restrict the key to the Places API. It is used server-side only and is never
# exposed to the browser.
#
# COST WARNING: each grid cell costs 1 Nearby Search + up to 3 pages, and each
# result costs 1 Place Details call (that is where the phone number comes
# from). A 60-cell run can be several thousand billable calls. The UI shows an
# estimated call count before you start a run.
GOOGLE_PLACES_API_KEY=

# Safety cap on how many cells a single run may cover. Stops an accidental
# 50km radius from burning through your Google billing quota.
PLACES_MAX_CELLS=120


# ---------------------------------------------------------------------------
# 6. Apify — the B2B LinkedIn scraper
# ---------------------------------------------------------------------------
# Token: https://console.apify.com/settings/integrations
APIFY_TOKEN=

# The actor to run, in `username~actor-name` form. Whichever LinkedIn / Sales
# Navigator actor you have chosen — lib/apify.ts normalises the common output
# field names (email / work_email, fullName / name, companyName / company,
# profileUrl / linkedinUrl) so most actors work without a code change.
APIFY_LINKEDIN_ACTOR_ID=

# How long to wait for an actor run before giving up, in seconds.
APIFY_RUN_TIMEOUT_SECONDS=600

# Your LinkedIn `li_at` session cookie. Most Sales Navigator actors need it
# (and a live Sales Navigator subscription) to see search results at all.
# It is a credential: it is merged into the actor input server-side and is
# never sent to the browser or typed into the scrape form.
APIFY_LINKEDIN_COOKIE=


# ---------------------------------------------------------------------------
# 6b. The daily send engine
# ---------------------------------------------------------------------------
# The app schedules its own sends: a ticker started by instrumentation.ts wakes
# once a minute and asks whether any campaign is due. Pace, send time and
# timezone are per-campaign settings in the UI, not env vars.
#
# Leave unset (or `true`) on Coolify, where the Node process is long-lived.
# Set to `false` on a second replica — one ticker is enough — or on a
# serverless host with no persistent process, where you should instead POST
# {"campaign_id":"…"} to /api/b2b/dispatch from a platform cron.
DISPATCH_TICKER_ENABLED=true


# ---------------------------------------------------------------------------
# 7. Email verification — B2B deliverability gate
# ---------------------------------------------------------------------------
# Contacts below the score threshold never enter the pipeline.
# Supported: `emailawesome`, `myemailverifier`, `none`.
# `none` skips verification and marks every contact email_verified=false —
# the app will still import them, but flags them as unverified in the UI
# rather than pretending they were checked.
EMAIL_VERIFIER_PROVIDER=none
EMAIL_VERIFIER_API_KEY=

# Minimum score (0–100) an address must reach to be imported.
EMAIL_VERIFIER_MIN_SCORE=80


# ---------------------------------------------------------------------------
# 8. TPS / CTPS — UK cold-calling compliance
# ---------------------------------------------------------------------------
# READ THIS: there is no free or official TPS lookup API. Real screening
# requires a paid licensed provider (Data8, TPS Services, or a DMA TPS Assured
# feed). Until you supply one, set TPS_PROVIDER=none — every scraped lead is
# then saved with tps_status="unchecked" and shown with an amber "UNSCREENED"
# badge. The system will never claim a number is TPS-clear when it has not
# actually been checked.
#
# Supported: `http`, `none`.
TPS_PROVIDER=none

# For TPS_PROVIDER=http: the app POSTs {"phone":"+441234567890"} to this URL
# with the key as a Bearer token, and expects a JSON reply containing a
# boolean under any of: listed / isListed / onTps / tps.
TPS_API_URL=
TPS_API_KEY=

# When true, numbers found on TPS/CTPS are DISCARDED at import rather than
# saved with a "listed" flag. Set false if you want them stored for audit but
# hidden from the calling list.
TPS_BLOCK_LISTED=true


# ---------------------------------------------------------------------------
# 9. Gemini — reply sentiment and draft generation
# ---------------------------------------------------------------------------
# NOT configured here. Gemini runs inside your n8n workflow, which posts the
# result back to /api/webhooks/inbound-reply. This app never calls Gemini
# directly, so no Gemini key belongs in this file. It goes in n8n's
# credentials instead. See docs/n8n-workflows.md.
