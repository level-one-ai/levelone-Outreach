    "viewRule": "",
    "createRule": "",
    "updateRule": "",
    "deleteRule": "",
    "schema": [
      {
        "name": "outreach_run",
        "type": "relation",
        "options": { "collectionId": "b2b_outreach", "maxSelect": 1 }
      },
      {
        "name": "direction",
        "type": "select",
        "options": { "maxSelect": 1, "values": ["inbound", "outbound"] }
      },
      { "name": "subject", "type": "text" },
      { "name": "body", "type": "text" },
      { "name": "sent_at", "type": "date" }
    ],
    "indexes": []
  },
  {
    "name": "scrape_runs",
    "type": "base",
    "listRule": "",
    "viewRule": "",
    "createRule": "",
    "updateRule": "",
    "deleteRule": "",
    "schema": [
      {
        "name": "kind",
        "type": "select",
        "options": { "maxSelect": 1, "values": ["trades", "b2b"] }
      },
      {
        "name": "status",
        "type": "select",
        "options": {
          "maxSelect": 1,
          "values": ["queued", "running", "complete", "failed"]
        }
      },
      { "name": "params", "type": "json" },
      { "name": "cells_total", "type": "number" },
      { "name": "cells_done", "type": "number" },
