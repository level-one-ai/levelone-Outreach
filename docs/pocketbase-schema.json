[
  {
    "name": "trades_leads",
    "type": "base",
    "listRule": "",
    "viewRule": "",
    "createRule": "",
    "updateRule": "",
    "deleteRule": "",
    "schema": [
      { "name": "company_name", "type": "text", "required": true },
      { "name": "location", "type": "text" },
      { "name": "phone", "type": "text", "required": true },
      { "name": "tps_verified", "type": "bool" },
      {
        "name": "tps_status",
        "type": "select",
        "options": {
          "maxSelect": 1,
          "values": ["unchecked", "clear", "listed", "error"]
        }
      },
      { "name": "email", "type": "text" },
      { "name": "website", "type": "text" },
      { "name": "call_date_time", "type": "date" },
      {
        "name": "status",
        "type": "select",
        "required": true,
        "options": {
          "maxSelect": 1,
          "values": ["scraped", "negative", "no_answer", "positive"]
        }
      },
      { "name": "meeting_sent", "type": "bool" },
      { "name": "place_id", "type": "text" },
      { "name": "grid_cell", "type": "text" }
    ],
    "indexes": [
      "CREATE UNIQUE INDEX `idx_trades_phone` ON `trades_leads` (`phone`)",
      "CREATE UNIQUE INDEX `idx_trades_place_id` ON `trades_leads` (`place_id`) WHERE `place_id` != ''"
    ]
  },
