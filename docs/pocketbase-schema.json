  {
    "name": "b2b_outreach",
    "type": "base",
    "listRule": "",
    "viewRule": "",
    "createRule": "",
    "updateRule": "",
    "deleteRule": "",
    "schema": [
      {
        "name": "contact",
        "type": "relation",
        "required": true,
        "options": { "collectionId": "b2b_contacts", "maxSelect": 1 }
      },
      {
        "name": "campaign",
        "type": "relation",
        "required": true,
        "options": { "collectionId": "b2b_campaigns", "maxSelect": 1 }
      },
      {
        "name": "kanban_stage",
        "type": "select",
        "required": true,
        "options": {
          "maxSelect": 1,
          "values": [
            "queued",
            "sending",
            "sent_1",
            "followup_2d",
            "followup_5d",
            "replied",
            "send_failed"
          ]
        }
      },
      {
        "name": "reply_sentiment",
        "type": "select",
        "options": {
          "maxSelect": 1,
          "values": ["pending", "positive", "negative", "no_reply"]
        }
      },
      { "name": "ai_draft_reply", "type": "text" },
      { "name": "call_booked", "type": "bool" },
      { "name": "call_booked_at", "type": "date" },
      { "name": "last_email_sent_at", "type": "date" },
      { "name": "archived", "type": "bool" },
      { "name": "send_attempts", "type": "number" },
      { "name": "queued_at", "type": "date" },
      { "name": "dispatched_at", "type": "date" },
      { "name": "send_error", "type": "text" }
    ],
    "indexes": [
      "CREATE UNIQUE INDEX `idx_outreach_contact_campaign` ON `b2b_outreach` (`contact`, `campaign`)"
    ]
  },
  {
    "name": "messages",
    "type": "base",
